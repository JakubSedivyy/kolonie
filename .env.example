# Zkopíruj jako .env a doplň. Soubor .env nikomu neposílej a nedávej na GitHub.

# Alpaca -> přepni na "Paper Trading" -> API Keys -> Generate
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Telegram (volitelné, ale doporučené - zprávy a ovládání z mobilu)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Režim: paper = simulované peníze. Na skutečné peníze: TRADING_MODE=live,
# I_UNDERSTAND_REAL_MONEY=yes a do ALPACA klíčů dát LIVE klíče (ne paper).
TRADING_MODE=paper
I_UNDERSTAND_REAL_MONEY=no

# Dashboard (install.sh heslo vygeneruje sám, když je prázdné)
DASHBOARD_PASSWORD=

# Trend radar - volitelné, funguje i bez nich
# CoinGecko demo klíč zdarma: https://www.coingecko.com/en/developers/dashboard
COINGECKO_API_KEY=
# Reddit aplikace typu "script": https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Grok (xAI) - čte X/Twitter. Klíč: https://console.x.ai -> API Keys (potřebuje předplacený kredit)
XAI_API_KEY=
XAI_DAILY_BUDGET=1.0
# volitelně konkrétní model, jinak zkusí grok-4.3 a pak grok-4.7
XAI_MODEL=
# YouTube Data API v3 (volitelné, zdarma): https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=
# Bluesky (volitelné, zdarma): Nastavení -> App Passwords
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
